{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static Site (index.html)",
      "runtimeExecutable": "/opt/homebrew/bin/python3",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    },
    {
      "name": "Flask Dev Server",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["app.py"],
      "port": 5000
    },
    {
      "name": "Gunicorn",
      "runtimeExecutable": "gunicorn",
      "runtimeArgs": ["app:app", "--bind", "0.0.0.0:8000", "--reload"],
      "port": 8000
    }
  ]
}
